{
  "name": "sol-memecoin-quant-bot",
  "version": "0.1.0",
  "description": "Autonomous SOL memecoin trading bot: Pump.fun scanning, Birdeye candles, news sentiment, whale tracking, Groq-scored signals, Jupiter execution.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scanner": "tsx scripts/test-scanner.ts",
    "backtest": "tsx scripts/backtest.ts",
    "demo:exits": "tsx scripts/exit-rules-demo.ts",
    "signal": "tsx scripts/stock-analyze.ts",
    "signal:backtest": "tsx scripts/stock-backtest.ts",
    "signal:fixtures": "tsx scripts/build-fixtures.ts",
    "signal:demo-fixtures": "tsx scripts/gen-demo-fixtures.ts",
    "futures": "tsx scripts/futures-analyze.ts",
    "futures:fixtures": "tsx scripts/build-futures-fixtures.ts",
    "futures:backtest": "tsx scripts/futures-backtest.ts",
    "futures:sweep": "tsx scripts/futures-sweep.ts",
    "futures:validate": "tsx scripts/futures-validate.ts",
    "futures:hud": "tsx scripts/build-futures-hud.ts",
    "signal:overlay": "tsx scripts/build-overlay.ts",
    "webhook": "tsx scripts/tv-webhook.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.4",
    "@types/ws": "^8.18.1",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
