{
  "name": "outreach-agent",
  "version": "0.2.0",
  "description": "24/7 outreach agent: finds Shopify stores and Meta advertisers, audits their website/store/ads, and drafts personalized pain-point emails sorted into Website, Ad Management and Shopify CRO queues for one-click approval.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "imapflow": "^1.0.164",
    "nodemailer": "^10.3.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
