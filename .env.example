# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Groq (sentiment analysis + trade scoring, free tier) --------------------
# Get a key at console.groq.com — no payment method required. Model IDs
# rotate over time; check console.groq.com/docs/models if these 404.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
SENTIMENT_MODEL=llama-3.1-8b-instant
SCORING_MODEL=llama-3.3-70b-versatile

# --- Birdeye (candles, token overview, safety, top holders) ------------------
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
# Minimum gap (ms) between Birdeye requests. The free tier rate-limits hard
# (429s); the bot self-throttles to this spacing. Raise it if you still see
# 429s, lower it on a paid Birdeye plan for faster evaluations.
BIRDEYE_MIN_REQUEST_INTERVAL_MS=1200

# --- Token discovery ---------------------------------------------------------
# "graduated" (default): tokens migrating to a DEX (~$69k) — the tokens the
#   pipeline can actually EVALUATE and TRADE (real Birdeye OHLCV/liquidity,
#   authorities usually revoked, low enough volume to dodge rate limits).
# "pumpportal": brand-new token creations (~$5k). High volume but tiny, no
#   Birdeye OHLCV, mostly rugs — hard to evaluate. New-mint exposure only.
# "pumpfun": pump.fun's unofficial HTTP endpoint (Cloudflare-blocked, 530s).
SCANNER_SOURCE=graduated
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPFUN_BASE_URL=https://frontend-api.pump.fun
PUMPFUN_SCAN_INTERVAL_MS=200

# --- Whale wallet tracking (free public Solana RPC polling, no Helius) -------
# Polls SOLANA_RPC_URL (below) per watched wallet instead of Helius
# webhooks. WHALE_POLL_INTERVAL_MS is deliberately conservative — the free
# public RPC endpoint is shared/rate-limited across everyone using it, so
# whale activity will lag real-time and can be unreliable under load. Use
# your own RPC provider (Helius, Triton, etc.) via SOLANA_RPC_URL if you
# need this to be faster/more reliable later.
# Whale tracking is optional and OFF by default — the free public Solana
# RPC throttles heavily (429 storms) when polling many wallets. To turn it
# on, point SOLANA_RPC_URL at a real RPC (e.g. a free Helius RPC key) and
# set this to true. The bot trades fine without it.
WHALE_TRACKING_ENABLED=false
WHALE_POLL_INTERVAL_MS=60000

# --- NewsAPI (crypto news for sentiment) -------------------------------------
NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

# --- Jupiter (swap execution) ------------------------------------------------
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Telegram (trade notifications + /status /stats /positions /help) -------
# Token from @BotFather. Leave blank to disable Telegram entirely.
TELEGRAM_BOT_TOKEN=
# The chat/user ID the bot should post to. See README for how to find yours.
TELEGRAM_CHAT_ID=

# --- Wallet -------------------------------------------------------------------
# Base58-encoded secret key. Only required when LIVE_TRADING=true.
# NEVER commit this value or paste it anywhere untrusted.
WALLET_PRIVATE_KEY=

# --- Execution mode -----------------------------------------------------------
# paper: full pipeline runs on real data, trades are simulated, no signing.
# live:  real signed Jupiter swaps. Requires WALLET_PRIVATE_KEY.
LIVE_TRADING=false

# --- Paper realism & go-live gating ---
# Round-trip execution cost applied to every PAPER exit (Jupiter fees +
# slippage on thin liquidity + priority fees). Without this, paper P&L fills
# at the perfect quoted price and a losing strategy looks "profitable" — the
# exact false positive that pushes you live into a loss. Raise for thinner
# tokens; it's applied per sell leg so it's conservative on scale-outs.
PAPER_TRADING_COST_PCT=0.04
# Objective go-live bar (shown in /stats). The paper stats must clear ALL of
# these before it's honest to risk real money.
GO_LIVE_MIN_TRADES=30
GO_LIVE_MIN_EXPECTANCY_PCT=1
# Daily digest: the bot pushes a summary (go-live gate + progress toward
# GO_LIVE_MIN_TRADES) to Telegram every N hours, so you can watch it daily
# without polling. Needs TELEGRAM_* set.
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_INTERVAL_HOURS=24
# Auto-calibration: the bot reads its own realized win rate per confidence
# bucket and RAISES the confidence gate to exclude levels that have been
# losing money — never below CONFIDENCE_THRESHOLD, and only after enough data.
ADAPTIVE_CONFIDENCE_ENABLED=true
ADAPTIVE_CONFIDENCE_MIN_SAMPLE=20
ADAPTIVE_CONFIDENCE_MIN_BUCKET=5
ADAPTIVE_CONFIDENCE_MARGIN_PCT=5

# --- Strategy parameters -------------------------------------------------------
# Entry gates. Defaults below are the PERMISSIVE paper posture: loose enough
# that the pipeline actually takes trades so /stats accumulates and you learn
# whether the strategy has edge. Tighten (e.g. 50000 / 0.72) before going live.
MIN_MARKET_CAP_USD=25000
CONFIDENCE_THRESHOLD=0.60
MAX_RISK_PCT_PER_TRADE=0.02
STOP_LOSS_PCT=0.20
# Once armed (peak price * (1-TRAILING_STOP_PCT) exceeds the fixed entry
# stop), the stop trails this far below the highest price seen since entry.
# Stays at this LOOSE width until partial profit is banked (see below).
TRAILING_STOP_PCT=0.25
# Max hold. 12 (not 48) so trades close and hit the ledger faster, reaching
# the 30-trade go-live gate in days not weeks. NOTE: this makes it a 12h-hold
# strategy variant — set back to 48 to validate the original.
MAX_POSITION_AGE_HOURS=12
MIN_SOL_RESERVE=0.5
WHALE_WATCHLIST_SIZE=50

# --- Profit-taking / stop-tightening ---
# Partial take-profit: once up TAKE_PROFIT_PCT, sell TAKE_PROFIT_SIZE_PCT of
# the position to bank the gain; the rest rides. Set TAKE_PROFIT_PCT=0 to
# disable (pure ride-the-trailing-stop, the original "let winners ride").
TAKE_PROFIT_PCT=0.60
TAKE_PROFIT_SIZE_PCT=0.50
# After banking partial profit — or after the peak is up BREAKEVEN_TRIGGER_PCT
# — the floor stop rises to breakeven so a winner can't become a full loss.
BREAKEVEN_TRIGGER_PCT=0.30
# The trailing stop tightens to this ONLY after partial profit is banked;
# before that it stays loose (TRAILING_STOP_PCT) so memecoin volatility can't
# wick the position out before it reaches the take-profit target.
TRAILING_STOP_TIGHT_PCT=0.15

# --- Rug/safety gate (src/safety/rugCheck.ts) -----------------------------------
# Hard pre-trade filter, runs before candles/sentiment/AI scoring. A token
# failing any of these is rejected outright, no AI call made.
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
MAX_TOP10_HOLDER_PCT=0.6
MAX_CREATOR_PCT=0.15
BLOCK_TOKEN2022_TRANSFER_FEE=true
MIN_LIQUIDITY_USD=4000

# --- Server ---------------------------------------------------------------------
PORT=3000
