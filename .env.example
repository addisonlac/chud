# ─────────────────────────────────────────────────────────────────────────────
# Outreach Agent — optional .env
#
# You DON'T need this file to get started: run the app and fill everything in
# on the Settings page. Values here are only defaults (handy for Docker);
# anything you save in the app's Settings page overrides them.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
PORT=3000
# 127.0.0.1 = only this computer can open the app. Use 0.0.0.0 on a server.
HOST=127.0.0.1
# REQUIRED when HOST is not 127.0.0.1 (protects the dashboard with a login).
APP_PASSWORD=
DB_PATH=data/outreach.db
OPEN_BROWSER=true
LOG_LEVEL=info

# --- Agent ---
NICHES=candles, skincare, pet supplies, jewelry, coffee, fitness apparel, home decor, supplements
SOURCES=shopify_search, shopify_ct, meta_ads
CYCLE_MINUTES=30
LEADS_PER_CYCLE=15
AUTO_START=true
MIN_SCORE=25
# Meta's API only returns commercial ads delivered in the EU (IE/MT are English-speaking).
META_COUNTRIES=IE, MT, NL, DE, FR

# --- API keys (all free tiers) ---
GROQ_API_KEY=            # console.groq.com — AI-written emails (template writer used without it)
GROQ_MODEL=llama-3.3-70b-versatile
BRAVE_API_KEY=           # api-dashboard.search.brave.com — Shopify store discovery
META_ACCESS_TOKEN=       # developers.facebook.com — Ad Library API
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=       # optional, raises Google PageSpeed limits

# --- You (used in every email) ---
SENDER_NAME=
SENDER_COMPANY=
SENDER_TITLE=
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_ADDRESS=          # physical mailing address — required by CAN-SPAM
SENDER_PROOF=            # a REAL result, used verbatim, e.g. "We took a candle brand from 1.1% to 2.4% conversion in 6 weeks."
BOOKING_URL=

# --- Sending (Gmail: smtp.gmail.com / 465 / an App Password) ---
FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
DAILY_CAP=30
FOLLOWUP_DAYS=3, 4       # follow-up 1 three days after the first email, follow-up 2 four days after that
SEND_WINDOW=08-18        # server-local hours, Mon–Fri

# --- Reply detection (defaults to the SMTP login) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=                 # e.g. https://outreach.yourdomain.com — linked in alerts
